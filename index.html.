<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --paper: #f2f5f8;
  --sheet: #fbfcfd;
  --ink: #16212c;
  --steel: #556575;
  --line: #c3ccd5;
  --dim: #1b6db3;
  --hi: #f2c200;
  --hi-ink: #16212c;
  --body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --head: "IBM Plex Sans Condensed", "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #0f1720;
    --sheet: #151f2a;
    --ink: #e7edf3;
    --steel: #9aabbb;
    --line: #2d3b4a;
    --dim: #5fb0f0;
    --hi: #f2c200;
    --hi-ink: #16212c;
  }
}
:root[data-theme="dark"] {
  --paper: #0f1720;
  --sheet: #151f2a;
  --ink: #e7edf3;
  --steel: #9aabbb;
  --line: #2d3b4a;
  --dim: #5fb0f0;
  --hi: #f2c200;
  --hi-ink: #16212c;
}
html { scroll-padding-top: env(safe-area-inset-top, 0px); }
*, *::before, *::after { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--body);
  font-size: 1rem;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--dim); text-underline-offset: 3px; }
a:focus-visible, button:focus-visible { outline: 3px solid var(--hi); outline-offset: 3px; border-radius: 2px; }

.sheet {
  max-width: 1040px;
  margin: 0 auto;
  padding: clamp(16px, 4vw, 48px) clamp(16px, 4vw, 40px) 64px;
}

/* Title block */
.title-block {
  border: 2px solid var(--ink);
  background: var(--sheet);
  display: grid;
  grid-template-columns: 1fr;
}
.tb-main { padding: clamp(20px, 4vw, 40px); border-bottom: 2px solid var(--ink); }
h1 {
  font-family: var(--head);
  font-weight: 700;
  font-size: clamp(2.8rem, 9vw, 5.6rem);
  line-height: 0.95;
  letter-spacing: -0.01em;
  margin: 0 0 18px;
}
.role {
  font-family: var(--head);
  font-weight: 500;
  font-size: clamp(1.1rem, 2.4vw, 1.4rem);
  color: var(--steel);
  margin: 0 0 20px;
}
.profile { max-width: 62ch; margin: 0; font-size: 1.05rem; }
.tb-cells { display: grid; grid-template-columns: repeat(2, 1fr); }
.cell { padding: 12px 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); min-width: 0; }
.cell:nth-child(2n) { border-right: 0; }
.cell dt { font-size: 0.8rem; color: var(--steel); margin: 0 0 2px; }
.cell dd { margin: 0; font-weight: 500; overflow-wrap: anywhere; }
.cell.wide { grid-column: 1 / -1; border-right: 0; }
@media (min-width: 760px) {
  .tb-cells { grid-template-columns: repeat(3, 1fr); }
  .cell:nth-child(2n) { border-right: 1px solid var(--line); }
  .cell:nth-child(3n) { border-right: 0; }
  .cell.wide { grid-column: auto; border-right: 0; }
  .cell { border-bottom: 1px solid var(--line); }
  .cell:nth-last-child(-n+3) { border-bottom: 0; }
}

/* Drawing */
.drawing {
  margin: 32px 0 0;
  border: 1px solid var(--line);
  background: var(--sheet);
  padding: 8px;
}
.drawing svg { display: block; width: 100%; height: auto; color: var(--ink); }
.drawing figcaption { padding: 8px 12px 6px; font-size: 0.9rem; color: var(--steel); }
.d-line { fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
.d-dim { fill: none; stroke: var(--dim); stroke-width: 1.5; }
.d-thin { fill: none; stroke: var(--steel); stroke-width: 1; stroke-dasharray: 5 4; }
.d-fill { fill: var(--hi); stroke: currentColor; stroke-width: 2; }
.d-text { font-family: var(--body); font-size: 14px; fill: var(--dim); font-weight: 500; }
.d-text.ink { fill: currentColor; }
@media (prefers-reduced-motion: no-preference) {
  .draw { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.6s ease-out forwards; }
  .draw.late { animation-delay: 0.9s; }
  .fade { opacity: 0; animation: fade 0.6s ease-out 1.6s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
}

/* Sections */
section { margin-top: 56px; }
h2 {
  font-family: var(--head);
  font-weight: 600;
  font-size: clamp(1.6rem, 3.5vw, 2.1rem);
  line-height: 1.1;
  margin: 0 0 20px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--ink);
}
h3 { font-family: var(--head); font-weight: 600; font-size: 1.35rem; line-height: 1.2; margin: 0; }
ul { margin: 10px 0 0; padding-left: 1.2rem; }
li { margin-bottom: 6px; max-width: 70ch; }
li::marker { color: var(--dim); }
.sub { margin: 2px 0 0; color: var(--steel); }

/* Projects */
.projects { display: grid; gap: 40px; grid-template-columns: 1fr; }
@media (min-width: 820px) { .projects { grid-template-columns: 1fr 1fr; gap: 56px; } }
.project { border-top: 6px solid var(--hi); padding-top: 14px; }
.stats { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; padding: 0; list-style: none; }
.stats li { margin: 0; border: 1px solid var(--line); background: var(--sheet); padding: 3px 10px; font-size: 0.9rem; font-weight: 500; border-radius: 2px; }

/* Timeline */
.entry { display: grid; grid-template-columns: 1fr; gap: 4px; padding: 20px 0; border-bottom: 1px solid var(--line); }
.entry:first-of-type { padding-top: 0; }
.entry:last-of-type { border-bottom: 0; }
.when { font-weight: 500; color: var(--dim); }
@media (min-width: 760px) {
  .entry { grid-template-columns: 200px 1fr; gap: 32px; }
}

/* Two column */
.cols { display: grid; gap: 40px; grid-template-columns: 1fr; }
@media (min-width: 820px) { .cols { grid-template-columns: 1fr 1fr; gap: 56px; } }
.skills { margin: 0; }
.skills dt { font-family: var(--head); font-weight: 600; font-size: 1.1rem; margin-top: 14px; }
.skills dt:first-child { margin-top: 0; }
.skills dd { margin: 2px 0 0; color: var(--steel); }

footer { margin-top: 64px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--steel); font-size: 0.9rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }

@media print {
  body { background: #fff; color: #000; }
  .drawing { display: none; }
  .sheet { padding: 0; }
}
</style>
